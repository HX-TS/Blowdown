    </main>
  </div>

  <dialog id="connectDialog" aria-labelledby="dialogTitle">
    <form class="dialog-inner" id="connectForm" method="dialog">
      <div class="dialog-head">
        <div>
          <h2 id="dialogTitle">Connect the source sheet</h2>
          <p>Paste the Google Apps Script web app URL for this spreadsheet. It should end in <code>/exec</code>.</p>
        </div>
        <button class="dialog-close" id="closeDialogButton" type="button" aria-label="Close">×</button>
      </div>
      <p class="dialog-note"><strong>Access matters:</strong> choose an Apps Script deployment audience that matches who may view these project logs. A public deployment can expose the spreadsheet data to anyone who has the endpoint.</p>
      <label class="field-label" for="endpointInput">Web app URL</label>
      <input class="connect-input" id="endpointInput" type="url" inputmode="url" placeholder="https://script.google.com/macros/s/.../exec" autocomplete="url" required>
      <p class="field-help">The endpoint is saved only in this browser's local storage. You can remove it later from this connection dialog.</p>
      <div class="dialog-actions">
        <button class="button-secondary" id="disconnectButton" type="button">Disconnect</button>
        <button class="button-secondary" id="cancelButton" type="button">Cancel</button>
        <button class="button-primary" type="submit">Connect</button>
      </div>
    </form>
  </dialog>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    "use strict";

    const STORAGE_KEY = "krejuv-fec-daily-log-endpoint-v1";
    // Leave blank for browser-by-browser setup. Set this only if the deployed page should load the sheet for every visitor.
    const DEFAULT_ENDPOINT = "";
    const savedEndpoint = localStorage.getItem(STORAGE_KEY);
    const state = { sheets: [], endpoint: savedEndpoint === null ? DEFAULT_ENDPOINT : savedEndpoint, expanded: true, error: "" };
    const $ = (selector) => document.querySelector(selector);
    const logList = $("#logList");
    const daysContainer = $("#daysContainer");
    const emptyState = $("#emptyState");
    const emptyTitle = $("#emptyTitle");
    const emptyCopy = $("#emptyCopy");
    const emptyMessage = $("#emptyMessage");
    const noResults = $("#noResults");
    const statusPill = $("#statusPill");
    const connectDialog = $("#connectDialog");
    const endpointInput = $("#endpointInput");

    function escapeHTML(value) {
      return String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char]));
    }

    function cleanRows(rows) {
      if (!Array.isArray(rows)) return [];
      return rows
        .filter((row) => Array.isArray(row) && row.some((cell) => String(cell ?? "").trim() !== ""))
        .map((row) => row.map((cell) => String(cell ?? "").trim()));
    }

    function parseTabDate(label) {
      const text = String(label || "").trim();
      let match = text.match(/^(\d{4})[./-](\d{1,2})[./-](\d{1,2})/);
      if (match) return new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));
      match = text.match(/^(\d{1,2})[./-](\d{1,2})[./-](\d{2,4})/);
      if (match) {
        let year = Number(match[3]);
        if (year < 100) year += year < 70 ? 2000 : 1900;
        return new Date(year, Number(match[2]) - 1, Number(match[1]));
      }
      const parsed = Date.parse(text);
      return Number.isNaN(parsed) ? null : new Date(parsed);
    }

    function formatDate(label) {
      const date = parseTabDate(label);
      if (!date || Number.isNaN(date.getTime())) return label || "Untitled day";
      return new Intl.DateTimeFormat("en-MY", { day: "numeric", month: "long", year: "numeric" }).format(date);
    }

    function sortSheets(sheets) {
      return [...sheets].sort((a, b) => {
        const dateA = parseTabDate(a.name);
        const dateB = parseTabDate(b.name);
        if (dateA && dateB) return dateB - dateA;
        if (dateA) return -1;
        if (dateB) return 1;
        return (Number(b.index) || 0) - (Number(a.index) || 0);
      });
    }

    function isHeaderRow(row) {
      const text = row.join(" ").toLowerCase();
      return /\b(time|activity|activities|description|task|status|remarks?|work|location|personnel|progress|action|item|start|finish|duration|update|log)\b/.test(text);
    }

    function renderRows(rows) {
      const data = cleanRows(rows);
      if (!data.length) return '<p class="log-note">No entries in this tab.</p>';
      const columns = Math.max(...data.map((row) => row.length));
      if (columns <= 1) {
        return '<div class="log-notes">' + data.map((row) => '<div class="log-note">' + escapeHTML(row[0]) + '</div>').join("") + '</div>';
      }
      const hasHeader = data.length > 1 && isHeaderRow(data[0]);
      const headers = hasHeader ? data[0] : Array.from({ length: columns }, (_, index) => `Field ${index + 1}`);
      const body = hasHeader ? data.slice(1) : data;
      const headerHTML = '<thead><tr>' + Array.from({ length: columns }, (_, index) => '<th>' + escapeHTML(headers[index] || `Field ${index + 1}`) + '</th>').join("") + '</tr></thead>';
      const rowsHTML = body.map((row) => '<tr>' + Array.from({ length: columns }, (_, index) => '<td>' + escapeHTML(row[index] || "") + '</td>').join("") + '</tr>').join("");
      if (!body.length) return '<div class="table-scroll"><table class="log-table">' + headerHTML + '<tbody></tbody></table></div>';
      return '<div class="table-scroll"><table class="log-table">' + headerHTML + '<tbody>' + rowsHTML + '</tbody></table></div>';
    }

    function daySearchText(sheet) {
      return [sheet.name, ...cleanRows(sheet.rows).flat()].join(" ").toLowerCase();
    }

    function render() {
      const sheets = sortSheets(state.sheets);
      const search = $("#searchInput").value.trim().toLowerCase();
      const visible = sheets.filter((sheet) => !search || daySearchText(sheet).includes(search));
      $("#dayCount").textContent = String(sheets.length);
      $("#latestDay").textContent = sheets.length ? formatDate(sheets[0].name) : "Waiting for sheet";
      $("#connectionSummary").textContent = state.error ? "Needs attention" : state.endpoint && sheets.length ? "Connected" : state.endpoint ? "No daily tabs" : "Not connected";
      $("#lastUpdated").textContent = state.lastUpdated ? `Updated ${new Intl.DateTimeFormat("en-MY", { dateStyle: "medium", timeStyle: "short" }).format(new Date(state.lastUpdated))}` : "Connect the source sheet to load daily tabs";
      $("#statusText").textContent = state.error ? "Connection error" : state.endpoint && sheets.length ? "Sheet connected" : state.endpoint ? "Connected · no entries" : "Not connected";
      statusPill.classList.toggle("connected", Boolean(state.endpoint && !state.error));
      statusPill.classList.toggle("error", Boolean(state.error));
      $("#expandButton").textContent = state.expanded ? "Collapse all" : "Expand all";

      daysContainer.innerHTML = visible.map((sheet, index) => {
        const rows = cleanRows(sheet.rows);
        const date = parseTabDate(sheet.name);
        const dateTile = date ? String(date.getDate()).padStart(2, "0") : "LOG";
        const status = sheet.id !== undefined ? `<a class="day-badge" href="${escapeHTML('https://docs.google.com/spreadsheets/d/1XAyrsD9GLGaY3ZnaiWnND25iF3DsvKR_rhKFXkcffmQ/edit#gid=' + encodeURIComponent(sheet.id))}" target="_blank" rel="noopener noreferrer">Open tab ↗</a>` : `<span class="day-badge">${rows.length} ${rows.length === 1 ? "row" : "rows"}</span>`;
        return `<details class="day-card" data-day="${escapeHTML(sheet.name)}" ${state.expanded ? "open" : ""}>
          <summary class="day-summary">
            <span class="calendar-icon">${escapeHTML(dateTile)}</span>
            <span class="day-heading"><strong>${escapeHTML(formatDate(sheet.name))}</strong><span>${rows.length} ${rows.length === 1 ? "log entry" : "log entries"}</span></span>
            ${status}
            <svg class="chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div class="day-content">${renderRows(rows)}</div>
        </details>`;
      }).join("");

      const hasRows = sheets.length > 0;
      emptyState.classList.toggle("hidden", hasRows);
      noResults.classList.toggle("hidden", !hasRows || visible.length > 0);
      if (!hasRows) {
        emptyTitle.textContent = state.error ? "Could not load the daily log" : state.endpoint ? "No daily entries found" : "Connect your daily log";
        emptyCopy.textContent = state.error
          ? "Check the web app URL and its access settings, then try again."
          : state.endpoint
            ? "The connector is responding, but it did not find any non-empty worksheet tabs. Add log entries to a day tab and refresh."
            : "Once connected, every non-empty worksheet tab will appear here as a day section. New daily tabs will load automatically when you refresh.";
        emptyMessage.textContent = state.error || "";
        emptyMessage.classList.toggle("hidden", !state.error);
      }
    }

    let toastTimer;
    function showToast(message) {
      const toast = $("#toast");
      toast.textContent = message;
      toast.classList.add("visible");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove("visible"), 2800);
    }

    function showConnectDialog() {
      endpointInput.value = state.endpoint;
      if (typeof connectDialog.showModal === "function") connectDialog.showModal();
      else connectDialog.setAttribute("open", "");
      setTimeout(() => endpointInput.focus(), 40);
    }

    function normalizeEndpoint(value) {
      const url = new URL(value.trim());
      if (url.protocol !== "https:") throw new Error("Enter a secure https:// web app URL.");
      if (!/script\.google\.com|script\.googleusercontent\.com/i.test(url.hostname)) throw new Error("Use the Google Apps Script web app URL ending in /exec.");
      if (!/\/exec\/?$/.test(url.pathname)) throw new Error("The web app URL must end in /exec.");
      return url.href;
    }

    function loadFromEndpoint() {
      if (!state.endpoint) { state.error = ""; state.sheets = []; render(); return; }
      state.error = "";
      state.sheets = [];
      render();
      const callbackName = "krejuvFecLogCallback";
      const timeout = setTimeout(() => {
        delete window[callbackName];
        state.error = "The connector did not respond. Check the deployment URL and access settings.";
        render();
      }, 15000);
      window[callbackName] = (payload) => {
        clearTimeout(timeout);
        delete window[callbackName];
        if (!payload || !Array.isArray(payload.sheets)) {
          state.error = "The connector response is not in the expected format. Replace Code.gs with the supplied connector and redeploy.";
          render();
          return;
        }
        state.sheets = payload.sheets.map((sheet, index) => ({
          name: String(sheet.name || `Day ${index + 1}`),
          id: sheet.id,
          index: sheet.index ?? index,
          rows: cleanRows(sheet.rows)
        })).filter((sheet) => sheet.rows.length > 0);
        state.lastUpdated = payload.updatedAt || new Date().toISOString();
        state.error = "";
        state.expanded = true;
        render();
        if (state.sheets.length) showToast(`${state.sheets.length} daily ${state.sheets.length === 1 ? "tab" : "tabs"} loaded.`);
      };
      try {
        const url = new URL(state.endpoint);
        url.searchParams.set("callback", callbackName);
        url.searchParams.set("_", String(Date.now()));
        const script = document.createElement("script");
        script.src = url.href;
        script.async = true;
        script.onerror = () => {
          clearTimeout(timeout);
          delete window[callbackName];
          state.error = "Could not reach the connector. Verify the URL, deployment and access settings.";
          render();
        };
        document.head.appendChild(script);
        script.onload = () => script.remove();
      } catch (error) {
        clearTimeout(timeout);
        state.error = error.message || "Invalid connector URL.";
        render();
      }
    }

    $("#connectTopButton").addEventListener("click", showConnectDialog);
    $("#connectEmptyButton").addEventListener("click", showConnectDialog);
    $("#closeDialogButton").addEventListener("click", () => connectDialog.close());
    $("#cancelButton").addEventListener("click", () => connectDialog.close());
    $("#connectForm").addEventListener("submit", (event) => {
      event.preventDefault();
      try {
        state.endpoint = normalizeEndpoint(endpointInput.value);
        localStorage.setItem(STORAGE_KEY, state.endpoint);
        connectDialog.close();
        loadFromEndpoint();
      } catch (error) {
        endpointInput.setCustomValidity(error.message || "Enter a valid web app URL.");
        endpointInput.reportValidity();
        endpointInput.addEventListener("input", () => endpointInput.setCustomValidity(""), { once: true });
      }
    });
    $("#disconnectButton").addEventListener("click", () => {
      localStorage.setItem(STORAGE_KEY, "");
      state.endpoint = "";
      state.error = "";
      state.sheets = [];
      state.lastUpdated = "";
      state.expanded = true;
      connectDialog.close();
      render();
      showToast("Google Sheet disconnected from this browser.");
    });
    $("#refreshButton").addEventListener("click", () => {
      if (!state.endpoint) { showConnectDialog(); return; }
      loadFromEndpoint();
    });
    $("#searchInput").addEventListener("input", render);
    $("#expandButton").addEventListener("click", () => {
      state.expanded = !state.expanded;
      render();
    });
    connectDialog.addEventListener("click", (event) => {
      if (event.target === connectDialog) connectDialog.close();
    });

    render();
    if (state.endpoint) loadFromEndpoint();
  </script>
</body>
</html>
